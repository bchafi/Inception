      "boundElements": null,
      "updated": 1787608510834,
      "link": null,
      "locked": false,
      "text": "containers are designed to be temporary. when you\ndown that container, that entire guest room—along\nwith all the database files saved inside it—is\ncompletely destroyed and wiped out.",
      "fontSize": 11.003171026136801,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "containers are designed to be temporary. when you down that container, that entire guest room—along with all the database files saved inside it—is completely destroyed and wiped out.",
      "autoResize": false,
      "lineHeight": 1.25
    },
