      "lineHeight": 1.25
    },
    {
      "id": "FJm0we1ZAE6Z0wcPApXok",
      "type": "text",
      "x": 1655.5657176373356,
      "y": 845.5409949968301,
      "width": 55.60516694011828,
      "height": 23.928669845614635,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
