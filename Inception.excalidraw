      "isDeleted": false,
      "boundElements": null,
      "updated": 1787611547375,
      "link": null,
      "locked": false,
      "text": "volume is completely independent of\nthe container\nA volume is not destroyed when a\ncontainer is stopped or removed\nunless you explicitly tell Docker to\ndelete the volume itself.",
      "fontSize": 3.1904893127486185,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "volume is completely independent of the container\nA volume is not destroyed when a container is stopped or removed unless you explicitly tell Docker to delete the volume itself.",
      "autoResize": false,
      "lineHeight": 1.25
    },
