      "text": "Volume is a storage object created\nand entirely managed by the Docker\ndaemon.",
      "fontSize": 3.1904893127486185,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Volume is a storage object created and entirely managed by the Docker daemon.",
