      "versionNonce": 1267437409,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787610998610,
      "link": null,
      "locked": false,
      "text": "Volume is a storage object\ncreated and entirely\nmanaged by the Docker\ndaemon.",
      "fontSize": 4.395753825475463,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Volume is a storage object created and entirely managed by the Docker daemon.",
