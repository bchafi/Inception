      "isDeleted": false,
      "boundElements": null,
      "updated": 1787610998610,
      "link": null,
      "locked": false,
      "text": "Volume is the preferred\nmechanism for persisting\ndata generated by and\nused by Docker containers.",
      "fontSize": 4.395753825475463,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Volume is the preferred mechanism for persisting data generated by and used by Docker containers.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "qLLfqK1ZVVzBlPNRJ71fH",
      "type": "text",
      "x": 1596.352855989273,
