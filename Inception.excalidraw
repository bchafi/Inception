      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Control Visibility (PIDs, Networks, Mounts, Users)\nGiving the process a restricted worldview so it thinks it is alone on the machine.",
      "autoResize": false,
      "lineHeight": 1.25
    },
