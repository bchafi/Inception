        {
          "id": "1zX4eD4WD5u-CYFFv_Tpt",
          "type": "arrow"
        }
      ],
      "updated": 1787602303933,
      "link": null,
      "locked": false,
      "text": "Enforces Resource Budgets (RAM, CPU,\nDisk I/O, PID limits).\nGiving the process a strict budget so it\ncannot crash the host machine by hogging\nRAM.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Enforces Resource Budgets (RAM, CPU, Disk I/O, PID limits).\nGiving the process a strict budget so it cannot crash the host machine by hogging RAM.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "YeUfJei420xM-D6ikkzTW",
      "type": "text",
      "x": 1197.6339786377487,
      "y": 758.8285674495987,
      "width": 340.2360404094598,
      "height": 140,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aNV",
      "roundness": null,
      "seed": 1540358063,
      "version": 1480,
      "versionNonce": 1383253473,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "71QR42y_IVGYxt8gJHPTc",
          "type": "arrow"
        }
      ],
      "updated": 1787611703320,
      "link": null,
      "locked": false,
      "text": "pivot_root() is a Linux system call (and\ncommand) that swaps the root filesystem\nof the calling process's mount namespace\nwith a new one. It moves the current root\nmount to a temporary directory and sets a\nnew directory as the absolute system root\n(/).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "pivot_root() is a Linux system call (and command) that swaps the root filesystem of the calling process's mount namespace with a new one. It moves the current root mount to a temporary directory and sets a new directory as the absolute system root (/).",
      "autoResize": false,
      "lineHeight": 1.25
    },
